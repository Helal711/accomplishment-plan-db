rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isDocOwner() {
      return isSignedIn() && request.auth.uid == resource.data.ownerUid;
    }

    function isCreateOwner() {
      return isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidTask(data) {
      return data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.description is string && data.description.size() <= 500 &&
             data.amount is string && data.amount.size() <= 50 &&
             (!('taskNumber' in data) || data.taskNumber is int) &&
             (!('paymentMode' in data) || data.paymentMode is string) &&
             (!('unit' in data) || data.unit is string) &&
             (!('priority' in data) || data.priority in ['High', 'Med', 'Low']) &&
             (!('status' in data) || data.status is string) &&
             (!('expectedDate' in data) || data.expectedDate is string) &&
             (!('accountName' in data) || data.accountName is string) &&
             (!('accountCode' in data) || data.accountCode is string) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 2000)) &&
             (!('monthYear' in data) || data.monthYear is string) &&
             (!('supp1Uploaded' in data) || data.supp1Uploaded is bool) &&
             (!('supp2Uploaded' in data) || data.supp2Uploaded is bool) &&
             (!('supp3Uploaded' in data) || data.supp3Uploaded is bool) &&
             (!('supp1FileUrl' in data) || data.supp1FileUrl is string) &&
             (!('supp2FileUrl' in data) || data.supp2FileUrl is string) &&
             (!('supp3FileUrl' in data) || data.supp3FileUrl is string) &&
             (!('supp1FileName' in data) || (data.supp1FileName is string && data.supp1FileName.size() <= 200)) &&
             (!('supp2FileName' in data) || (data.supp2FileName is string && data.supp2FileName.size() <= 200)) &&
             (!('supp3FileName' in data) || (data.supp3FileName is string && data.supp3FileName.size() <= 200)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAccount(data) {
      return data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.accountName is string && data.accountName.size() <= 200 &&
             data.accountCode is string && data.accountCode.size() <= 50 &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidStatus(data) {
      return data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.statusName is string && data.statusName.size() <= 100 &&
             (!('isDefault' in data) || data.isDefault is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Default deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Tasks Collection
    match /Tasks/{taskId} {
      allow get: if isDocOwner();
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCreateOwner() && isValidTask(incoming());
      allow update: if isDocOwner() &&
                       incoming().ownerUid == existing().ownerUid &&
                       isValidTask(incoming());
      allow delete: if isDocOwner();
    }

    // Account List Collection
    match /Account_List/{accountId} {
      allow get: if isDocOwner();
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCreateOwner() && isValidAccount(incoming());
      allow update: if isDocOwner() &&
                       incoming().ownerUid == existing().ownerUid &&
                       isValidAccount(incoming());
      allow delete: if isDocOwner();
    }

    // Status List Collection
    match /Status_List/{statusId} {
      allow get: if isDocOwner();
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isCreateOwner() && isValidStatus(incoming());
      allow update: if isDocOwner() &&
                       incoming().ownerUid == existing().ownerUid &&
                       isValidStatus(incoming());
      allow delete: if isDocOwner();
    }
  }
}
