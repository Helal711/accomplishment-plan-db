{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "An accomplishment plan task item belonging to a specific workspace owner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "taskNumber": {
          "type": "integer",
          "description": "Sequential user-facing task number"
        },
        "description": {
          "type": "string",
          "description": "Task description or title"
        },
        "amount": {
          "type": "string",
          "description": "Amount in TK"
        },
        "paymentMode": {
          "type": "string",
          "enum": ["Cash", "Bank", "Cheque"],
          "description": "Payment mode"
        },
        "unit": {
          "type": "string",
          "description": "Factory unit (e.g. Unit-1, Unit-2)"
        },
        "priority": {
          "type": "string",
          "enum": ["High", "Med", "Low"],
          "description": "Task priority level"
        },
        "status": {
          "type": "string",
          "description": "Current status (Draft Ready, Done, Advance Ready, etc.)"
        },
        "expectedDate": {
          "type": "string",
          "description": "Expected completion date"
        },
        "accountName": {
          "type": "string",
          "description": "Associated account name"
        },
        "accountCode": {
          "type": "string",
          "description": "Account code auto-filled from master list"
        },
        "category": {
          "type": "string",
          "description": "Category taxonomy classification"
        },
        "remarks": {
          "type": "string",
          "description": "Remarks or notes"
        },
        "monthYear": {
          "type": "string",
          "description": "Month-year category (e.g. Nov-2026)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when task was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when task was last updated"
        }
      },
      "required": ["ownerUid", "taskNumber", "description", "amount", "paymentMode", "unit", "priority", "status", "monthYear"]
    },
    "AccountItem": {
      "title": "AccountItem",
      "description": "Master account item belonging to a specific workspace owner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "accountName": {
          "type": "string",
          "description": "Name of the account"
        },
        "accountCode": {
          "type": "string",
          "description": "Auto-filled code for the account"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["ownerUid", "accountName", "accountCode"]
    },
    "StatusItem": {
      "title": "StatusItem",
      "description": "Custom status option belonging to a specific workspace owner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "statusName": {
          "type": "string",
          "description": "Name of the status"
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether status is a default status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["ownerUid", "statusName"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Custom category taxonomy belonging to a specific workspace owner",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "categoryName": {
          "type": "string",
          "description": "Name of the category"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["ownerUid", "categoryName"]
    },
    "MonthCounter": {
      "title": "MonthCounter",
      "description": "Per-user per-month task serial number counter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID formatted as {ownerUid}_{monthYear}"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner"
        },
        "monthYear": {
          "type": "string",
          "description": "Month-year category (e.g. Nov-2026)"
        },
        "lastTaskNumber": {
          "type": "integer",
          "description": "Latest assigned task number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["ownerUid", "monthYear", "lastTaskNumber"]
    }
  },
  "firestore": {
    "/Tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Per-user accomplishment plan tasks"
    },
    "/Account_List/{accountId}": {
      "schema": {
        "$ref": "#/entities/AccountItem"
      },
      "description": "Per-user master account directory"
    },
    "/Status_List/{statusId}": {
      "schema": {
        "$ref": "#/entities/StatusItem"
      },
      "description": "Per-user custom status options"
    },
    "/Category_List/{categoryId}": {
      "schema": {
        "$ref": "#/entities/CategoryItem"
      },
      "description": "Per-user custom categories"
    },
    "/Month_Counters/{counterId}": {
      "schema": {
        "$ref": "#/entities/MonthCounter"
      },
      "description": "Per-user per-month task serial number counter"
    }
  }
}
